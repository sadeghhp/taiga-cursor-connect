{
  "name": "taiga-cursor-connect",
  "version": "0.7.0",
  "description": "MCP server connecting Cursor to Taiga",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prebuild:docker": "npm ci && npm run build && npm ci --omit=dev",
    "docker:build": "npm run prebuild:docker && docker build -t taiga-mcp:local .",
    "start": "node dist/server.js",
    "dev": "tsx scripts/dev.mjs",
    "test": "npm run build && tsx --test src/**/*.test.ts",
    "test:watch": "tsx --test --watch 'src/**/*.test.ts'",
    "smoke": "tsx scripts/smoke-mcp-tools.ts",
    "docs:mcp-tools": "npm run build && node scripts/update-mcp-tools-md.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
