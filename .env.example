# Taiga API base URL
# Docker (default): reach host Taiga from container
TAIGA_API_URL=http://host.docker.internal:9000/api/v1
# Local dev without Docker:
# TAIGA_API_URL=http://localhost:9000/api/v1

# --- Auth (pick one mode) ---
# Recommended: Taiga login (connector calls POST /api/v1/auth on startup)
# TAIGA_USERNAME=admin
# TAIGA_PASSWORD=

# Legacy: static bearer token (+ optional refresh for auto-renewal on 401)
# TAIGA_TOKEN=
# TAIGA_REFRESH_TOKEN=

# MCP stderr logging: off | info | debug (default off; stdout stays JSON-RPC only)
# TAIGA_MCP_LOG=off

# Tool tiers (default: core — 38 tools). Higher tiers include lower.
# TAIGA_MCP_TOOL_TIERS=default
# TAIGA_MCP_TOOL_TIERS=extended
# TAIGA_MCP_TOOL_TIERS=advanced
# TAIGA_MCP_TOOL_TIERS=all
# TAIGA_MCP_TOOL_TIERS=full
# TAIGA_MCP_TOOL_TIERS_STRICT=true
